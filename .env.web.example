# Settings are supplied by start-web.ps1 or the process environment.
# This example is not loaded automatically; Demo is the default.
RA_WEB_MODE=demo
RA_AGENT_URL=http://127.0.0.1:2025
# RA_WEB_DATA=absolute/path/to/separate/server/data
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
# Live reads existing server-side .env: POLZA_API_KEY, POLZA_MODEL, TAVILY_API_KEY.
# Never place secrets in web/static or send them to the browser.
